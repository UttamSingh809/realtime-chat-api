# ==========================================
# PRODUCTION ENVIRONMENT TEMPLATE
# ==========================================
# DO NOT COMMIT real secrets.
# Set these via your hosting provider's secret store.

NODE_ENV=production
PORT=5000
API_PREFIX=/api
APP_NAME=RealTime Chat API

# --- Database (MongoDB Atlas recommended) ---
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/realtime-chat?retryWrites=true&w=majority

# --- Redis (Upstash / Redis Cloud recommended) ---
REDIS_URL=rediss://default:<password>@<host>:<port>
REDIS_ENABLED=true

# --- JWT (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---JWT_ACCESS_SECRET=REPLACE_ME_64_HEX_CHARS
JWT_REFRESH_SECRET=REPLACE_ME_DIFFERENT_64_HEX_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# --- CORS (your frontend origins, comma-separated) ---
CORS_ORIGIN=https://app.yourdomain.com

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# --- File uploads: use cloudinary for production ---
UPLOAD_PROVIDER=cloudinary
MAX_FILE_SIZE=10485760
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
CLOUDINARY_FOLDER=realtime-chat
THUMBNAIL_SIZE=200

# --- Email (SendGrid / Postmark / SES) ---
EMAIL_ENABLED=true
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_SENDGRID_KEY
EMAIL_FROM="RealTime Chat <noreply@yourdomain.com>"

# --- Client ---
CLIENT_URL=https://app.yourdomain.com

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=logs

# --- Swagger ---
SWAGGER_ENABLED=false