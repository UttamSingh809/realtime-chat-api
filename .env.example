# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=development
PORT=5000
API_PREFIX=/api
APP_NAME=RealTime Chat API

# ==========================================
# DATABASE
# ==========================================
MONGODB_URI=mongodb://localhost:27017/realtime-chat
# For production with Atlas:
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/realtime-chat?retryWrites=true&w=majority

# ==========================================
# REDIS (Optional but recommended for scaling)
# ==========================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# ==========================================
# JWT
# ==========================================
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# BCRYPT
# ==========================================
BCRYPT_SALT_ROUNDS=12

# ==========================================
# CORS
# ==========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ==========================================
# FILE UPLOADS
# ==========================================
UPLOAD_PROVIDER=local
# UPLOAD_PROVIDER=cloudinary
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# ==========================================
# CLOUDINARY (if UPLOAD_PROVIDER=cloudinary)
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=realtime-chat
# Optional
THUMBNAIL_SIZE=200

# ==========================================
# EMAIL (Optional - for password reset, verification)
# ==========================================
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="RealTime Chat <noreply@realtimechat.com>"

# ==========================================
# CLIENT
# ==========================================
CLIENT_URL=http://localhost:3000

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info
LOG_DIR=logs

# ==========================================
# SWAGGER
# ==========================================
SWAGGER_ENABLED=true